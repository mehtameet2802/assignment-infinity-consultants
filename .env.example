# SQLite database URL (default: ./spend_tracker.db in project root)
DATABASE_URL=sqlite:///./spend_tracker.db

# API key authentication (set AUTH_ENABLED=true in production)
AUTH_ENABLED=true

# High-entropy secret used to HMAC-hash API keys before SQLite storage.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=replace-with-long-random-secret

# Werkzeug hash of the administrator password (rotation only).
# Generate with: flask --app 'app:create_app()' auth hash-password
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
